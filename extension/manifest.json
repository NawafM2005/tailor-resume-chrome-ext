{
  "manifest_version": 3,
  "name": "Resume Tailor",
  "version": "2.0",
  "description": "Tailor your resume and cover letter to any job description and download polished PDFs.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
